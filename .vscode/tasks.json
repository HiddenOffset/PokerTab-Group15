{
    "version": "2.0.0",
    "tasks": [
        {
            "label": "configure",
            "type": "shell",
            "command": "cmake -S . -B build",
            "problemMatcher": []
        },
        {
            "label": "build",
            "type": "shell",
            "command": "cmake --build build",
            "group": { "kind": "build", "isDefault": true },
            "problemMatcher": ["$gcc", "$msCompile"],
            "dependsOn": "configure"
        },
        {
            "label": "test",
            "type": "shell",
            "command": "ctest --test-dir build --output-on-failure",
            "group": { "kind": "test", "isDefault": true },
            "problemMatcher": [],
            "dependsOn": "build"
        },
        {
            "label": "run app",
            "type": "shell",
            "windows": { "command": "build\\app\\Debug\\pokertab.exe" },
            "linux":   { "command": "./build/app/pokertab" },
            "osx":     { "command": "./build/app/pokertab" },
            "problemMatcher": [],
            "dependsOn": "build"
        }
    ]
}
