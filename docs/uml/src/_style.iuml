' Shared look for every sequence diagram. Included by each sequence-*.puml.
skinparam backgroundColor white
skinparam defaultFontName Helvetica
skinparam defaultFontSize 13
skinparam shadowing false
skinparam sequence {
  ArrowColor #3A3A3A
  ArrowThickness 1.5
  LifeLineBorderColor #8A8A8A
  LifeLineBackgroundColor #F4F4F2
  ParticipantBackgroundColor #FFFFFF
  ParticipantBorderColor #3A3A3A
  ParticipantBorderThickness 1.5
  ActorBackgroundColor #FFFFFF
  ActorBorderColor #3A3A3A
  GroupBorderColor #3A3A3A
  GroupBackgroundColor #E8E8E4
}
skinparam titleFontSize 16
hide footbox
